DATABASE_URL=jdbc:postgresql://database:5432/fixup
DATABASE_USERNAME=fixup
DATABASE_PASSWORD=change-me-local
AUTH0_ISSUER_URI=https://example.auth0.com/
AUTH0_AUDIENCE=https://api.example.com
CORS_ALLOWED_ORIGINS=http://localhost:4200
POSTGRES_DB=fixup
POSTGRES_PORT=5432
BACKEND_PORT=8080
# Auth0 issuers end with /. JWKS defaults to <issuer>.well-known/jwks.json.
# AUTH0_JWK_SET_URI is an optional trusted-server configuration, never supplied by clients.
