              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PieceResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/media/me/portfolio/{pieceId}/hide" : {
      "post" : {
        "tags" : [ "portfolio-controller" ],
        "summary" : "Take a piece out of the public portfolio",
        "operationId" : "hide",
        "parameters" : [ {
          "name" : "pieceId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "400" : {
