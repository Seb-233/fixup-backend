            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PieceResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/auth/select-role" : {
      "post" : {
        "tags" : [ "current-user-controller" ],
        "summary" : "Request an initial role idempotently",
        "description" : "Only OWNER, TENANT and FIXER are self-assignable. FIXER starts PENDING. Administrative roles require a dedicated administrative use case.",
        "operationId" : "selectRole",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RoleRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "400" : {
            "description" : "Invalid role, missing role or unexpected client fields",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid bearer token",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Inactive account or forbidden role assignment",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Bootstrap is required before accessing the internal account",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200" : {
            "description" : "The current user's internal roles",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RolesResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/auth/bootstrap" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "summary" : "Provision the authenticated identity idempotently",
        "description" : "No body or an empty object. Subject and initial profile come only from the validated JWT.",
        "operationId" : "bootstrap",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/BootstrapRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "Existing active account",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BootstrapResponse"
                }
              }
            }
          },
          "201" : {
            "description" : "New account without roles",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BootstrapResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Unexpected client fields or invalid initial profile",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid bearer token",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Account suspended or disabled",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Identity conflict",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/media/fixers/{fixerUserId}/portfolio" : {
      "get" : {
        "tags" : [ "portfolio-controller" ],
        "summary" : "Read the public portfolio of a fixer",
        "description" : "Returns only the pieces the fixer chose to show, in publication order.",
        "operationId" : "portfolioOf",
        "parameters" : [ {
          "name" : "fixerUserId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "400" : {
            "description" : "Invalid kind, missing field or unexpected client fields",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid bearer token",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Inactive account, or the fixer is not verified",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "A publication rule of the portfolio rejected the operation",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200" : {
            "description" : "The public portfolio of that fixer",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/PieceResponse"
                  }
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/auth/me" : {
      "get" : {
        "tags" : [ "current-user-controller" ],
        "summary" : "Read the current internal account",
        "operationId" : "me",
        "responses" : {
          "400" : {
            "description" : "Invalid role, missing role or unexpected client fields",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid bearer token",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Inactive account or forbidden role assignment",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Bootstrap is required before accessing the internal account",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200" : {
            "description" : "Current active account",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "PieceRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "kind" : {
            "type" : "string",
            "enum" : [ "PHOTO", "VIDEO" ]
          },
          "storageKey" : {
            "type" : "string",
            "maxLength" : 512,
            "minLength" : 0
          },
          "title" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "description" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0
          }
        },
        "required" : [ "kind", "storageKey", "title" ]
      },
      "ErrorResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "path" : {
            "type" : "string"
          }
        }
      },
      "PieceResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "kind" : {
            "type" : "string",
            "enum" : [ "PHOTO", "VIDEO" ]
          },
          "storageKey" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "description" : {
            "type" : [ "string", "null" ]
          },
          "position" : {
            "type" : "integer",
            "format" : "int32"
          },
          "visibility" : {
            "type" : "string",
            "enum" : [ "PUBLIC", "HIDDEN" ]
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "id", "kind", "position", "storageKey", "title", "visibility" ]
      },
      "Role" : {
        "type" : "string",
        "enum" : [ "OWNER", "TENANT", "FIXER", "REAL_ESTATE_MANAGER", "PLATFORM_ADMIN" ]
      },
      "RoleRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "role" : {
            "$ref" : "#/components/schemas/Role"
          }
        },
        "required" : [ "role" ]
      },
      "RolesResponse" : {
        "type" : "object",
        "properties" : {
          "roles" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Role"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "roles" ]
      },
      "BootstrapRequest" : {
        "type" : "object",
        "additionalProperties" : false
      },
      "BootstrapResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "externalSubject" : {
            "type" : "string"
          },
          "email" : {
            "type" : [ "string", "null" ]
          },
          "displayName" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "$ref" : "#/components/schemas/UserStatus"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Role"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "displayName", "email", "externalSubject", "id", "roles", "status" ]
      },
      "UserStatus" : {
        "type" : "string",
        "enum" : [ "ACTIVE", "SUSPENDED", "DISABLED" ]
      },
      "UserResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : [ "string", "null" ]
          },
          "displayName" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "$ref" : "#/components/schemas/UserStatus"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Role"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "displayName", "email", "id", "roles", "status" ]
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}
