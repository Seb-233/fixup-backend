        "properties" : {
          "mediaId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "title" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "description" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0
          }
        },
        "required" : [ "mediaId", "title" ]
      },
      "PieceResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "mediaId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "title" : {
            "type" : "string"
          },
          "description" : {
            "type" : [ "string", "null" ]
          },
          "position" : {
            "type" : "integer",
            "format" : "int32"
          },
          "visibility" : {
            "type" : "string",
            "enum" : [ "PUBLIC", "HIDDEN" ]
          },
          "readUrl" : {
            "type" : "string"
          },
          "readUrlExpiresAt" : {
            "type" : "string",
            "format" : "date-time"
