  "components" : {
    "schemas" : {
      "OpenRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "specialty" : {
            "$ref" : "#/components/schemas/Specialty"
          },
          "title" : {
            "type" : "string",
            "maxLength" : 150,
            "minLength" : 0
          },
          "description" : {
            "type" : "string",
            "maxLength" : 2000,
            "minLength" : 0
          },
          "photoKeys" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "maxLength" : 512,
              "minLength" : 0
            },
            "maxItems" : 6,
            "minItems" : 0
          }
        },
        "required" : [ "description", "specialty", "title" ]
      },
      "Specialty" : {
        "type" : "string",
        "enum" : [ "PLUMBING", "ELECTRICAL", "PAINTING", "CARPENTRY", "MASONRY", "GENERAL" ]
      },
      "ErrorResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "path" : {
            "type" : "string"
          }
        }
      },
      "RepairRequestStatus" : {
        "type" : "string",
        "enum" : [ "OPEN", "ASSIGNED" ]
      },
      "RequestResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "ownerUserId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "specialty" : {
            "$ref" : "#/components/schemas/Specialty"
          },
          "title" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "photoKeys" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "status" : {
            "$ref" : "#/components/schemas/RepairRequestStatus"
          },
          "assignedFixerUserId" : {
            "type" : [ "string", "null" ],
            "format" : "uuid"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "createdAt", "description", "id", "ownerUserId", "photoKeys", "specialty", "status", "title" ]
      },
      "QuotationRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "requestId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "amount" : {
            "type" : "integer",
            "format" : "int64",
            "minimum" : 1
          },
          "estimatedDays" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 365,
            "minimum" : 1
          },
          "message" : {
            "type" : "string",
            "maxLength" : 1000,
            "minLength" : 0
          }
        },
        "required" : [ "amount", "estimatedDays", "requestId" ]
      },
      "QuotationResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "requestId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "fixerUserId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "amount" : {
            "type" : "integer",
            "format" : "int64"
          },
          "estimatedDays" : {
            "type" : "integer",
            "format" : "int32"
          },
          "message" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "$ref" : "#/components/schemas/QuotationStatus"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "amount", "createdAt", "estimatedDays", "fixerUserId", "id", "requestId", "status" ]
      },
      "QuotationStatus" : {
        "type" : "string",
        "enum" : [ "SUBMITTED", "ACCEPTED", "REJECTED" ]
      },
      "RejectionRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "reason" : {
            "type" : "string",
            "maxLength" : 500,
            "minLength" : 0
          }
        },
        "required" : [ "reason" ]
      },
      "DocumentRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "type" : {
            "$ref" : "#/components/schemas/FixerVerificationDocumentType"
          },
          "storageKey" : {
            "type" : "string",
            "maxLength" : 512,
            "minLength" : 0
          }
        },
        "required" : [ "storageKey", "type" ]
      },
      "DocumentsRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "documents" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/DocumentRequest"
            },
            "maxItems" : 4,
            "minItems" : 0
          }
        },
        "required" : [ "documents" ]
      },
      "FixerVerificationDocumentType" : {
        "type" : "string",
        "enum" : [ "ID_CARD", "TRADE_CERTIFICATE", "BACKGROUND_CHECK", "INSURANCE" ]
      },
      "VerificationResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "PENDING", "VERIFIED", "REJECTED", "SUSPENDED" ]
          },
          "underReview" : {
            "type" : "boolean"
          },
          "submittedAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "decidedAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "rejectionReason" : {
            "type" : [ "string", "null" ]
          },
          "submittedDocuments" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FixerVerificationDocumentType"
            },
            "uniqueItems" : true
          },
          "missingDocuments" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FixerVerificationDocumentType"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "missingDocuments", "status", "submittedDocuments", "underReview" ]
      },
      "Role" : {
        "type" : "string",
        "enum" : [ "OWNER", "TENANT", "FIXER", "REAL_ESTATE_MANAGER", "PLATFORM_ADMIN" ]
      },
      "RoleRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "role" : {
            "$ref" : "#/components/schemas/Role"
          }
        },
        "required" : [ "role" ]
      },
      "RolesResponse" : {
        "type" : "object",
        "properties" : {
          "roles" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Role"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "roles" ]
      },
      "BootstrapRequest" : {
        "type" : "object",
        "additionalProperties" : false
      },
      "BootstrapResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "externalSubject" : {
            "type" : "string"
          },
          "email" : {
            "type" : [ "string", "null" ]
          },
          "displayName" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "$ref" : "#/components/schemas/UserStatus"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Role"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "displayName", "email", "externalSubject", "id", "roles", "status" ]
      },
      "UserStatus" : {
        "type" : "string",
        "enum" : [ "ACTIVE", "SUSPENDED", "DISABLED" ]
      },
      "UserResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : [ "string", "null" ]
          },
          "displayName" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "$ref" : "#/components/schemas/UserStatus"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Role"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "displayName", "email", "id", "roles", "status" ]
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}
