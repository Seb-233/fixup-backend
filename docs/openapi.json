{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "FixUp identity API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "paths" : {
    "/fixers/{fixerUserId}/verification/reject" : {
      "post" : {
        "tags" : [ "fixer-verification-controller" ],
        "summary" : "Reject a fixer verification",
        "description" : "Requires an active PLATFORM_ADMIN.",
        "operationId" : "reject",
        "parameters" : [ {
          "name" : "fixerUserId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RejectionRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "400" : {
            "description" : "Invalid document type, missing field or unexpected client fields",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid bearer token",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Inactive account, missing FIXER role or missing administrative privileges",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "The transition does not apply to the current verification state",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "204" : {
            "description" : "The fixer is rejected and may submit again"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/fixers/{fixerUserId}/verification/approve" : {
      "post" : {
        "tags" : [ "fixer-verification-controller" ],
        "summary" : "Approve a fixer verification",
        "description" : "Requires an active PLATFORM_ADMIN.",
        "operationId" : "approve",
        "parameters" : [ {
          "name" : "fixerUserId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "400" : {
            "description" : "Invalid document type, missing field or unexpected client fields",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid bearer token",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Inactive account, missing FIXER role or missing administrative privileges",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "The transition does not apply to the current verification state",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "204" : {
            "description" : "The fixer is verified"
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/fixers/me/verification/documents" : {
      "post" : {
        "tags" : [ "fixer-verification-controller" ],
        "summary" : "File the verification documents and open the administrative review",
        "description" : "The body carries storage keys only. Files are uploaded by the client against a signed URL, so no document content crosses this API. Documents may be filed one at a time; the review opens by itself once the mandatory set is complete. Resubmitting a type replaces its key.",
        "operationId" : "submit",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DocumentsRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "400" : {
            "description" : "Invalid document type, missing field or unexpected client fields",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid bearer token",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Inactive account, missing FIXER role or missing administrative privileges",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "The transition does not apply to the current verification state",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200" : {
            "description" : "Verification state after the submission",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/VerificationResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/auth/select-role" : {
      "post" : {
        "tags" : [ "current-user-controller" ],
        "summary" : "Request an initial role idempotently",
        "description" : "Only OWNER, TENANT and FIXER are self-assignable. FIXER starts PENDING. Administrative roles require a dedicated administrative use case.",
        "operationId" : "selectRole",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RoleRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "400" : {
            "description" : "Invalid role, missing role or unexpected client fields",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid bearer token",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Inactive account or forbidden role assignment",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Bootstrap is required before accessing the internal account",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200" : {
            "description" : "The current user's internal roles",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RolesResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/auth/bootstrap" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "summary" : "Provision the authenticated identity idempotently",
        "description" : "No body or an empty object. Subject and initial profile come only from the validated JWT.",
        "operationId" : "bootstrap",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/BootstrapRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "Existing active account",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BootstrapResponse"
                }
              }
            }
          },
          "201" : {
            "description" : "New account without roles",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BootstrapResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Unexpected client fields or invalid initial profile",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid bearer token",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Account suspended or disabled",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Identity conflict",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/fixers/me/verification" : {
      "get" : {
        "tags" : [ "fixer-verification-controller" ],
        "summary" : "Read the current fixer's own verification state",
        "operationId" : "myVerification",
        "responses" : {
          "400" : {
            "description" : "Invalid document type, missing field or unexpected client fields",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid bearer token",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Inactive account, missing FIXER role or missing administrative privileges",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "The transition does not apply to the current verification state",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200" : {
            "description" : "Verification state of the current fixer",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/VerificationResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/auth/me" : {
      "get" : {
        "tags" : [ "current-user-controller" ],
        "summary" : "Read the current internal account",
        "operationId" : "me",
        "responses" : {
          "400" : {
            "description" : "Invalid role, missing role or unexpected client fields",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid bearer token",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Inactive account or forbidden role assignment",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Bootstrap is required before accessing the internal account",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200" : {
            "description" : "Current active account",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/analytics/zones/{zone}/market-indicators" : {
      "get" : {
        "tags" : [ "market-indicators-controller" ],
        "summary" : "Read the real estate market indicators of a zone",
        "description" : "freshness says where the value comes from: LIVE from the external source in this request, CACHED from a still fresh cache entry, DEGRADED when the source did not answer and the last known value is served instead. observedAt always carries the moment the source produced the value, so a degraded answer is never presented as a current one.",
        "operationId" : "ofZone",
        "parameters" : [ {
          "name" : "zone",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "maxLength" : 64,
            "minLength" : 0
          }
        } ],
        "responses" : {
          "400" : {
            "description" : "The zone is missing or too long",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid bearer token",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Inactive account",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503" : {
            "description" : "The external source failed and no known value exists",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200" : {
            "description" : "Indicators of that zone, with their provenance",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/IndicatorsResponse"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "RejectionRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "reason" : {
            "type" : "string",
            "maxLength" : 500,
            "minLength" : 0
          }
        },
        "required" : [ "reason" ]
      },
      "ErrorResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "path" : {
            "type" : "string"
          }
        }
      },
      "DocumentRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "type" : {
            "$ref" : "#/components/schemas/FixerVerificationDocumentType"
          },
          "storageKey" : {
            "type" : "string",
            "maxLength" : 512,
            "minLength" : 0
          }
        },
        "required" : [ "storageKey", "type" ]
      },
      "DocumentsRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "documents" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/DocumentRequest"
            },
            "maxItems" : 4,
            "minItems" : 0
          }
        },
        "required" : [ "documents" ]
      },
      "FixerVerificationDocumentType" : {
        "type" : "string",
        "enum" : [ "ID_CARD", "TRADE_CERTIFICATE", "BACKGROUND_CHECK", "INSURANCE" ]
      },
      "VerificationResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "PENDING", "VERIFIED", "REJECTED", "SUSPENDED" ]
          },
          "underReview" : {
            "type" : "boolean"
          },
          "submittedAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "decidedAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "rejectionReason" : {
            "type" : [ "string", "null" ]
          },
          "submittedDocuments" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FixerVerificationDocumentType"
            },
            "uniqueItems" : true
          },
          "missingDocuments" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FixerVerificationDocumentType"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "missingDocuments", "status", "submittedDocuments", "underReview" ]
      },
      "Role" : {
        "type" : "string",
        "enum" : [ "OWNER", "TENANT", "FIXER", "REAL_ESTATE_MANAGER", "PLATFORM_ADMIN" ]
      },
      "RoleRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "role" : {
            "$ref" : "#/components/schemas/Role"
          }
        },
        "required" : [ "role" ]
      },
      "RolesResponse" : {
        "type" : "object",
        "properties" : {
          "roles" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Role"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "roles" ]
      },
      "BootstrapRequest" : {
        "type" : "object",
        "additionalProperties" : false
      },
      "BootstrapResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "externalSubject" : {
            "type" : "string"
          },
          "email" : {
            "type" : [ "string", "null" ]
          },
          "displayName" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "$ref" : "#/components/schemas/UserStatus"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Role"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "displayName", "email", "externalSubject", "id", "roles", "status" ]
      },
      "UserStatus" : {
        "type" : "string",
        "enum" : [ "ACTIVE", "SUSPENDED", "DISABLED" ]
      },
      "UserResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : [ "string", "null" ]
          },
          "displayName" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "$ref" : "#/components/schemas/UserStatus"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Role"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "displayName", "email", "id", "roles", "status" ]
      },
      "IndicatorsResponse" : {
        "type" : "object",
        "properties" : {
          "zone" : {
            "type" : "string"
          },
          "pricePerSquareMeter" : {
            "type" : "number"
          },
          "yearOverYearVariationPercent" : {
            "type" : "number"
          },
          "averageDaysOnMarket" : {
            "type" : "integer",
            "format" : "int32"
          },
          "observedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "freshness" : {
            "type" : "string",
            "enum" : [ "LIVE", "CACHED", "DEGRADED" ]
          },
          "degraded" : {
            "type" : "boolean"
          }
        },
        "required" : [ "averageDaysOnMarket", "degraded", "freshness", "observedAt", "pricePerSquareMeter", "yearOverYearVariationPercent", "zone" ]
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}
