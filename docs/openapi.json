  "components" : {
    "schemas" : {
      "UploadRequestDto" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "purpose" : {
            "type" : "string",
            "minLength" : 1
          },
          "contentType" : {
            "type" : "string",
            "minLength" : 1
          },
          "sizeBytes" : {
            "type" : "integer",
            "format" : "int64"
          }
