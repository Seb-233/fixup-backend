  "components" : {
    "schemas" : {
      "RejectionRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "reason" : {
            "type" : "string",
            "maxLength" : 500,
            "minLength" : 0
          }
        },
        "required" : [ "reason" ]
      },
      "ErrorResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "path" : {
            "type" : "string"
          }
        }
      },
      "DocumentRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "type" : {
            "$ref" : "#/components/schemas/FixerVerificationDocumentType"
          },
          "storageKey" : {
            "type" : "string",
            "maxLength" : 512,
            "minLength" : 0
          }
        },
        "required" : [ "storageKey", "type" ]
      },
      "DocumentsRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "documents" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/DocumentRequest"
            },
            "maxItems" : 4,
            "minItems" : 0
          }
        },
        "required" : [ "documents" ]
      },
      "FixerVerificationDocumentType" : {
        "type" : "string",
        "enum" : [ "ID_CARD", "TRADE_CERTIFICATE", "BACKGROUND_CHECK", "INSURANCE" ]
      },
      "VerificationResponse" : {
        "type" : "object",
        "properties" : {
