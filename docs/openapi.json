            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "path" : {
            "type" : "string"
          }
        }
      },
      "UploadTicketDto" : {
        "type" : "object",
        "properties" : {
          "mediaId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "method" : {
            "type" : "string"
          },
          "uploadUrl" : {
            "type" : "string"
          },
          "headers" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            }
          },
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "expiresAt", "headers", "mediaId", "method", "uploadUrl" ]
