        "type" : "string",
        "enum" : [ "ID_CARD", "TRADE_CERTIFICATE", "BACKGROUND_CHECK", "INSURANCE" ]
      },
      "VerificationResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "PENDING", "VERIFIED", "REJECTED", "SUSPENDED" ]
          },
          "underReview" : {
            "type" : "boolean"
          },
          "submittedAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "decidedAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "rejectionReason" : {
            "type" : [ "string", "null" ]
          },
          "submittedDocuments" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FixerVerificationDocumentType"
            },
            "uniqueItems" : true
          },
          "missingDocuments" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FixerVerificationDocumentType"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "missingDocuments", "status", "submittedDocuments", "underReview" ]
      },
      "Role" : {
        "type" : "string",
        "enum" : [ "OWNER", "TENANT", "FIXER", "REAL_ESTATE_MANAGER", "PLATFORM_ADMIN" ]
      },
      "RoleRequest" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "role" : {
            "$ref" : "#/components/schemas/Role"
          }
        },
        "required" : [ "role" ]
      },
      "RolesResponse" : {
        "type" : "object",
        "properties" : {
          "roles" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Role"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "roles" ]
      },
      "BootstrapRequest" : {
        "type" : "object",
        "additionalProperties" : false
      },
      "BootstrapResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "externalSubject" : {
            "type" : "string"
          },
          "email" : {
            "type" : [ "string", "null" ]
          },
          "displayName" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "$ref" : "#/components/schemas/UserStatus"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Role"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "displayName", "email", "externalSubject", "id", "roles", "status" ]
      },
      "UserStatus" : {
        "type" : "string",
        "enum" : [ "ACTIVE", "SUSPENDED", "DISABLED" ]
      },
      "OwnPortfolioResponse" : {
        "type" : "object",
        "properties" : {
          "fixerUserId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "status" : {
            "type" : "string"
          },
          "publishedAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "pieces" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/PieceResponse"
            }
          }
        },
        "required" : [ "fixerUserId", "pieces", "status" ]
      },
      "UserResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : [ "string", "null" ]
          },
          "displayName" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "$ref" : "#/components/schemas/UserStatus"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Role"
            },
            "uniqueItems" : true
          }
        },
        "required" : [ "displayName", "email", "id", "roles", "status" ]
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
